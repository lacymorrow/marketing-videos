#!/bin/bash
# Tell Lacy something needs a human (a permission prompt, Juno not visible): a Slack DM from the rig itself. Nothing on zero is involved.
. "$(dirname "$0")/../lib.sh"
MSG="$*"; [ -z "$MSG" ] && exit 2; h=$(printf %s "$MSG" | md5 -q); [ -f $RUN/notified-$h ] && exit 0; touch $RUN/notified-$h
log "ATTENTION: $MSG"
# --sender tags this for the LAC-8649 send gate. The rig runs on graphite, so
# this is the one sender in the census that is not on zero at all.
[ -x ~/.openclaw/scripts/slack-post.sh ] && ~/.openclaw/scripts/slack-post.sh -c U3XC80UUQ --sender juno-demo-rig -m "Juno rig on $(hostname -s): $MSG" >/dev/null 2>&1 || true
